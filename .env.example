# ==============================================================================
# VERTIX PARKING / SANT WAMANBHAU PARKING — ENVIRONMENT CONFIGURATION
# Copy this file to `.env.local` for local development or set in hosting provider.
# NEVER commit production credentials or secret keys to source control.
# ==============================================================================

# Supabase Project Connection (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Gate Booth Attendant Background Auth (Optional / Recommended for Multi-Device Gate Booths)
# Used to authenticate in-booth attendants entering via PIN numbers.
NEXT_PUBLIC_BOOTH_EMAIL=admin@santwamanbhau.com
NEXT_PUBLIC_BOOTH_PASSWORD=your-secure-booth-password

# Local SQLite Database (Optional for native / Capacitor desktop offline cache)
DATABASE_URL=file:./dev.db
